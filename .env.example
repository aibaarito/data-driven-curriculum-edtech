# Copy to backend/.env (local run) or .env (docker compose). Never commit real keys or passwords.

# --- Database ---------------------------------------------------------------------------------------
# local embedded Postgres (dev.sh)
DATABASE_URL=postgresql+psycopg://ddc:ddc_dev_pw@127.0.0.1:55433/ddc
# Test database: its name MUST end in _test, the test suite wipes it.
TEST_DATABASE_URL=postgresql+psycopg://ddc:ddc_dev_pw@127.0.0.1:55433/ddc_test
# docker compose: required, choose a strong value
POSTGRES_PASSWORD=

# --- Access -----------------------------------------------------------------------------------------
# Unset: restricted local-demo mode (API answers loopback clients only; UI must be bound to 127.0.0.1).
# Set: every /api call needs "Authorization: Bearer <API_TOKEN>"; the Next.js server adds it (also set it
# for the frontend process). docker compose requires it.
API_TOKEN=
# Destructive "delete all data": off unless ENABLE_DATA_RESET=true AND ADMIN_TOKEN (>= 16 chars) is set.
ENABLE_DATA_RESET=false
ADMIN_TOKEN=
# Optional HTTP Basic auth for the whole UI (frontend process).
DEMO_BASIC_AUTH_USER=
DEMO_BASIC_AUTH_PASSWORD=

# --- Optional LLM (deterministic explanations when empty) ------------------------------------------
# anthropic | openai_compatible | none
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# only for openai_compatible
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- Limits -----------------------------------------------------------------------------------------
# enforced while the upload is received
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=200000
# import previews expire and their staged rows are purged
PREVIEW_TTL_MINUTES=60

CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
# frontend: where the server-side proxy forwards /api/*
API_URL=http://127.0.0.1:8010
