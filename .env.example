# Copy to backend/.env (local run) or .env (docker compose). Never commit real keys.

# PostgreSQL connection used by the backend
DATABASE_URL=postgresql+psycopg://ddc:ddc_dev_pw@127.0.0.1:55433/ddc
# Test database (must end in _test; tests wipe it)
TEST_DATABASE_URL=postgresql+psycopg://ddc:ddc_dev_pw@127.0.0.1:55433/ddc_test
POSTGRES_PASSWORD=ddc_dev_pw

# Optional LLM. Leave LLM_API_KEY empty to use the deterministic explainer.
LLM_PROVIDER=anthropic            # anthropic | openai_compatible | none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=                     # only for openai_compatible
LLM_TIMEOUT_SECONDS=30

# Upload limits
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=200000

# Allowed browser origins for direct API access (the UI normally goes through the Next.js proxy)
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# Frontend: where Next.js proxies /api/*
API_URL=http://127.0.0.1:8010
