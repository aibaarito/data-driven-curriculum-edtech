# --- Secrets & environment (only the template is committed) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/
npm-debug.log*

# --- Playwright artifacts ---
frontend/test-results/
frontend/e2e/report/
frontend/playwright/.cache/
frontend/e2e/screenshots/bad.csv

# --- Local databases & data stores ---
devdb/
*.sqlite
*.sqlite3
*.db
pgdata/
.local-services.json
verification/*.env
verification/browser-state.json

# Keep compact, sanitized QA evidence; local captures and runtime files stay private.
verification/*
!verification/results.json
!verification/route-coverage.json
!verification/compose-static.json
!verification/client-secret-scan.json
!verification/upload-smoke.json
!verification/live-smoke-default.json
